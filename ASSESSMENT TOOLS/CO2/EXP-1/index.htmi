<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Responsive Layout</title>
    <link rel="stylesheet" href="style.css">
</head>
<body>

<header>
    <h1>Retail Store</h1>
</header>

<nav>
    <a href="#">Home</a>
    <a href="#">Products</a>
    <a href="#">Services</a>
    <a href="#">Contact</a>
</nav>

<div class="container">
    <aside>
        <h2>Categories</h2>
        <ul>
            <li>Electronics</li>
            <li>Fashion</li>
            <li>Furniture</li>
        </ul>
    </aside>

    <main>
        <h2>Welcome</h2>
        <p>This is a responsive webpage using CSS Flexbox.</p>
    </main>
</div>

<footer>
    © 2026 Retail Store
</footer>

</body>
</html>
